generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  active
  inactive
}

enum AccountStatus {
  available
  reserved
  sent
  disabled
  manual
}

enum FulfillmentStatus {
  pending
  in_progress
  completed
  purchase_decided
  manual_review
  failed
  returned
}

enum DeliveryChannel {
  alimtalk
}

enum DeliveryLogStatus {
  queued
  sent
  failed
}

enum ReviewCodeStatus {
  unused
  used
}

enum ExpenseCategory {
  game_purchase
  country_change
  review_game
  other
}

enum ExpensePayer {
  song_donggeon
  im_jeongbin
}

enum SteamRegistrationStatus {
  received // 접수됨 (파싱 직후)
  needs_info // 필수 항목 누락 — 챗봇 되묻기 진행 중
  completed // 운영자 등록 작업 완료
}

enum SteamRegistrationMatchStatus {
  unmatched // 미연결
  auto_matched // 성함+게임명 자동매칭
  manual_matched // 관리자 수동연결
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(320)
  password  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  communityPosts CommunityPost[]

  @@map("admins")
}

model SteamProduct {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String           @db.VarChar(255)
  naverProductId      String           @unique @map("naver_product_id") @db.VarChar(100)
  price               Int?             @map("price")
  discountPricePc     Int?             @map("discount_price_pc")
  discountPriceMobile Int?             @map("discount_price_mobile")
  status              ProductStatus    @default(draft)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts            SteamAccount[]
  orderItems          SteamOrderItem[]

  @@map("steam_products")
}

model SteamAccount {
  id                     String           @id @default(uuid()) @db.Uuid
  productId              String?          @map("product_id") @db.Uuid
  productNameSnapshot    String?          @map("product_name_snapshot") @db.VarChar(255)
  username               String
  password               String
  email                  String           @map("email") @db.VarChar(320)
  emailPassword          String           @map("email_password")
  emailSiteUrl           String           @map("email_site_url") @db.VarChar(2048)
  secondaryEmail         String?          @map("secondary_email") @db.VarChar(320)
  secondaryEmailPassword String?          @map("secondary_email_password")
  secondaryEmailSiteUrl  String?          @map("secondary_email_site_url") @db.VarChar(2048)
  status                 AccountStatus    @default(available)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  product                SteamProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItems             SteamOrderItem[]

  @@index([productId, status, createdAt])
  @@map("steam_accounts")
}

model SteamOrderItem {
  id                   String            @id @default(uuid()) @db.Uuid
  productOrderId       String            @unique @map("product_order_id") @db.VarChar(100)
  naverOrderId         String            @map("naver_order_id") @db.VarChar(100)
  productId            String?           @map("product_id") @db.Uuid
  accountId            String?           @map("account_id") @db.Uuid
  productName          String            @map("product_name") @db.VarChar(255)
  receiverPhoneNumber  String?           @map("receiver_phone_number") @db.VarChar(30)
  receiverName         String?           @map("receiver_name") @db.VarChar(100)
  unitPrice            Int               @map("unit_price")
  paymentAmount        Int?              @map("payment_amount")
  settlementAmount     Int?              @map("settlement_amount")
  decisionDate         DateTime?         @map("decision_date") @db.Timestamptz(6)
  fulfillmentStatus    FulfillmentStatus @default(pending) @map("fulfillment_status")
  errorMessage         String?           @map("error_message")
  paidAt               DateTime?         @map("paid_at") @db.Timestamptz(6)
  returnedAt           DateTime?         @map("returned_at") @db.Timestamptz(6)
  reviewGameSentAt     DateTime?         @map("review_game_sent_at") @db.Timestamptz(6)
  friendLink1          String?           @map("friend_link1") @db.VarChar(500)
  friendLink2          String?           @map("friend_link2") @db.VarChar(500)
  giftCode             String?           @map("gift_code") @db.VarChar(200)
  gameUrl              String?           @map("game_url") @db.VarChar(500)
  memo                 String?           @map("memo")
  giftCompletedAt      DateTime?         @map("gift_completed_at") @db.Timestamptz(6)
  estimatedCompletedAt DateTime?         @map("estimated_completed_at") @db.Timestamptz(6)
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  product              SteamProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  account              SteamAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deliveryLogs         DeliveryLog[]
  registrations        SteamRegistration[]

  @@index([fulfillmentStatus, createdAt])
  @@index([naverOrderId])
  @@map("steam_order_items")
}

model SteamRegistration {
  id          String  @id @default(uuid()) @db.Uuid
  orderItemId String? @map("order_item_id") @db.Uuid

  // 파싱 항목 — 전부 nullable (best-effort 저장)
  steamId            String?  @map("steam_id") @db.VarChar(255)
  steamPassword      String?  @map("steam_password") @db.VarChar(255) // 평문 저장 (사용자 결정)
  gameName           String?  @map("game_name") @db.VarChar(255)
  buyerName          String?  @map("buyer_name") @db.VarChar(100)
  steamGuardCodes    String?  @map("steam_guard_codes") // 양식 A: 1회용 코드 원문 보존
  steamGuardDisabled Boolean? @map("steam_guard_disabled") // 양식 B: 가드 해제 여부
  refundConsent      Boolean  @default(false) @map("refund_consent")

  // 원본 / 메타
  rawMessage    String   @map("raw_message") @db.Text
  formVariant   String?  @map("form_variant") @db.VarChar(10) // A/B/C/unknown
  botUserKey    String   @map("bot_user_key") @db.VarChar(255)
  missingFields String[] @map("missing_fields") // 누락 필수항목 키

  matchStatus SteamRegistrationMatchStatus @default(unmatched) @map("match_status")
  status      SteamRegistrationStatus      @default(received)
  adminMemo   String?                      @map("admin_memo") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem SteamOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([matchStatus, createdAt])
  @@index([botUserKey, createdAt])
  @@map("steam_registrations")
}

model DeliveryLog {
  id                 String            @id @default(uuid()) @db.Uuid
  orderItemId        String?           @map("order_item_id") @db.Uuid
  partyApplicationId String?           @map("party_application_id") @db.Uuid
  channel            DeliveryChannel   @map("channel")
  recipient          String            @map("recipient") @db.VarChar(100)
  templateCode       String?           @map("template_code") @db.VarChar(50)
  status             DeliveryLogStatus @default(queued)
  errorMessage       String?           @map("error_message")
  providerMessageId  String?           @map("provider_message_id") @db.VarChar(100)
  sentAt             DateTime?         @map("sent_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  orderItem          SteamOrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  partyApplication   PartyApplication? @relation(fields: [partyApplicationId], references: [id], onDelete: Cascade)

  @@index([orderItemId, createdAt])
  @@index([partyApplicationId, createdAt])
  @@map("delivery_logs")
}

model AlimtalkSettings {
  id              String   @id @default(uuid()) @db.Uuid
  enabled         Boolean  @default(true)
  messageTemplate String   @map("message_template")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("alimtalk_settings")
}

model ReviewCode {
  id        String           @id @default(uuid()) @db.Uuid
  gameName  String?          @map("game_name") @db.VarChar(255)
  code      String           @db.VarChar(255)
  status    ReviewCodeStatus @default(unused)
  usedBy    String?          @map("used_by") @db.VarChar(255)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([gameName])
  @@map("review_codes")
}

model SystemSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  alimtalkUnitCost       Decimal  @default(6.5) @map("alimtalk_unit_cost") @db.Decimal(7, 1)
  defaultDurationMinutes Int      @default(60) @map("default_duration_minutes")
  chatbotWelcomeMessage  String?  @map("chatbot_welcome_message") @db.Text // 카카오 챗봇 웰컴 인사말
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

// 카카오 챗봇 메뉴 항목 — 관리자 페이지에서 CRUD, 챗봇이 클릭형 메뉴로 노출
model ChatbotMenuItem {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @db.VarChar(100) // 버튼 텍스트(이모지 포함) — 챗봇 발화 매칭 키
  body      String   @db.Text // 응답 본문
  imageUrl  String?  @map("image_url") @db.VarChar(500) // 응답 이미지(선택)
  buttons   Json     @default("[]") // 외부링크 버튼 배열 [{ label, url }]
  sortOrder Int      @default(0) @map("sort_order") // 메뉴 노출 순서
  isActive  Boolean  @default(true) @map("is_active") // 노출 여부
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("chatbot_menu_items")
}

model ManualRevenue {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  amount    Int
  memo      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([date])
  @@map("manual_revenues")
}

model Expense {
  id        String          @id @default(uuid()) @db.Uuid
  date      DateTime        @db.Timestamptz(6)
  category  ExpenseCategory
  payer     ExpensePayer    @default(song_donggeon)
  amount    Int
  memo      String?         @db.VarChar(500)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([date])
  @@index([category, date])
  @@map("expenses")
}

// ───────────────────────── 유저 인증 (OTTALL) ─────────────────────────

enum AuthProvider {
  local
  kakao
  google
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique @db.VarChar(320)
  password      String?
  name          String       @db.VarChar(100)
  phone         String       @unique @db.VarChar(20)
  phoneVerified Boolean      @default(false) @map("phone_verified")
  provider      AuthProvider @default(local)
  providerId    String?      @map("provider_id") @db.VarChar(255)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  termsAgreements   TermsAgreement[]
  partyApplications PartyApplication[]
  ownReviews        OwnReview[]
  communityPosts    CommunityPost[]

  @@unique([provider, providerId])
  @@map("users")
}

model TermsAgreement {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  type     String   @db.VarChar(30)
  agreedAt DateTime @default(now()) @map("agreed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("terms_agreements")
}

// ───────────────────────── OTT 상품 (OTTALL) ─────────────────────────

enum OwnProductStatus {
  recruiting
  closed
  expired
}

enum PartyApplicationStatus {
  pending
  confirmed
  cancelled
  expired
}

model OwnCategory {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(100)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  OwnProduct[]

  @@map("own_categories")
}

model OwnProduct {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(255)
  categoryId      String           @map("category_id") @db.Uuid
  durationDays    Int              @map("duration_days")
  price           Int
  dailyDiscount   Int              @default(0) @map("daily_discount")
  totalSlots      Int              @map("total_slots")
  filledSlots     Int              @default(0) @map("filled_slots")
  imagePath       String?          @map("image_path") @db.VarChar(500)
  notes           String?          @db.Text
  accountId       String?          @map("account_id") @db.Text
  accountPassword String?          @map("account_password") @db.Text
  status          OwnProductStatus @default(recruiting)
  startedAt       DateTime?        @map("started_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  leaderName      String           @map("leader_name") @db.VarChar(100)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     OwnCategory        @relation(fields: [categoryId], references: [id])
  applications PartyApplication[]
  reviews      OwnReview[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("own_products")
}

model PartyApplication {
  id          String                 @id @default(uuid()) @db.Uuid
  productId   String                 @map("product_id") @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  price       Int
  fee         Int
  totalAmount Int                    @map("total_amount")
  status      PartyApplicationStatus @default(pending)
  startedAt   DateTime?              @map("started_at") @db.Timestamptz(6)
  expiresAt   DateTime?              @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      OwnProduct    @relation(fields: [productId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  review       OwnReview?
  deliveryLogs DeliveryLog[]

  @@unique([productId, userId])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("party_applications")
}

model OwnReview {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  content       String   @db.Text
  rating        Int
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  application PartyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  product     OwnProduct       @relation(fields: [productId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([rating, createdAt])
  @@map("own_reviews")
}

model PhoneVerification {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @db.VarChar(20)
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@map("phone_verifications")
}

// ───────────────────────── 커뮤니티 ─────────────────────────

enum CommunityCategory {
  notice
  free
}

model CommunityPost {
  id            String            @id @default(uuid()) @db.Uuid
  category      CommunityCategory
  title         String            @db.VarChar(200)
  content       String            @db.Text
  imageUrl      String?           @map("image_url") @db.VarChar(500)
  isPinned      Boolean           @default(false) @map("is_pinned")
  authorUserId  String?           @map("author_user_id") @db.Uuid
  authorAdminId String?           @map("author_admin_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(6)

  authorUser  User?  @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAdmin Admin? @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([deletedAt, category, createdAt])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, isPinned, createdAt])
  @@map("community_posts")
}
