generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  active
  inactive
}

// 스토어 구분 — 멀티스토어 상품 동기화용 (streampocket: 기존 스토어 / pokemon_steam: 신규)
enum Store {
  streampocket
  pokemon_steam
}

// 상품 타입 — 기존엔 상품명 접미사로 판별했으나 게임 마스터에 명시 컬럼으로 보유
enum SteamProductType {
  AA
  NA
  BG
}

enum AccountStatus {
  available
  reserved
  sent
  disabled
  manual
}

enum FulfillmentStatus {
  pending
  in_progress
  completed
  purchase_decided
  manual_review
  failed
  returned
}

// 주문 출처 — naver: 스마트스토어 자동 감지 / manual: 관리자 수동 등록 / party: OTTALL 파티 승인 자동 생성
enum OrderSource {
  naver
  manual
  party
  gcoin // 배그 지코인 (pubgcode.kr 신청 승인 건)
}

enum DeliveryChannel {
  alimtalk
}

enum DeliveryLogStatus {
  queued
  sent
  failed
}

enum ReviewCodeStatus {
  unused
  used
}

enum ExpenseCategory {
  game_purchase
  country_change
  review_game
  other
}

enum ExpensePayer {
  song_donggeon
  im_jeongbin
}

enum SteamRegistrationStatus {
  received // 접수됨 (파싱 직후)
  needs_info // 필수 항목 누락 — 챗봇 되묻기 진행 중
  completed // 운영자 등록 작업 완료
}

enum SteamRegistrationMatchStatus {
  unmatched // 미연결
  auto_matched // 성함+게임명 자동매칭
  manual_matched // 관리자 수동연결
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(320)
  password  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  communityPosts CommunityPost[]

  @@map("admins")
}

model SteamProduct {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String           @db.VarChar(255)
  naverProductId      String           @unique @map("naver_product_id") @db.VarChar(100)
  price               Int?             @map("price")
  discountPricePc     Int?             @map("discount_price_pc")
  discountPriceMobile Int?             @map("discount_price_mobile")
  status              ProductStatus    @default(draft)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts            SteamAccount[]
  orderItems          SteamOrderItem[]

  @@map("steam_products")
}

// 게임 마스터 — 멀티스토어 공통 게임 단위. NA 계정 재고를 공유하고 타입을 보유한다.
model SteamGame {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(255)
  productType SteamProductType @map("product_type")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  listings   StoreListing[]
  accounts   SteamAccount[]
  orderItems SteamOrderItem[]

  @@map("steam_games")
}

// 스토어별 리스팅 — 한 게임이 스토어마다 갖는 네이버 상품(가격·네이버ID는 스토어별로 다름)
model StoreListing {
  id                  String        @id @default(uuid()) @db.Uuid
  store               Store
  gameId              String        @map("game_id") @db.Uuid
  naverProductId      String        @unique @map("naver_product_id") @db.VarChar(100)
  price               Int?
  discountPricePc     Int?          @map("discount_price_pc")
  discountPriceMobile Int?          @map("discount_price_mobile")
  status              ProductStatus @default(draft)
  // 네이버 실제 판매상태(statusType: SALE/OUTOFSTOCK/SUSPENSION/WAIT/CLOSE 등). 동기화 시 갱신.
  // 미정의 값 안전을 위해 enum 대신 String. null = 아직 미동기화.
  naverSaleStatus     String?       @map("naver_sale_status") @db.VarChar(30)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  game                SteamGame     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([store, gameId])
  @@index([store, status])
  @@map("store_listings")
}

model SteamAccount {
  id                     String           @id @default(uuid()) @db.Uuid
  productId              String?          @map("product_id") @db.Uuid
  gameId                 String?          @map("game_id") @db.Uuid
  productNameSnapshot    String?          @map("product_name_snapshot") @db.VarChar(255)
  username               String
  password               String
  email                  String           @map("email") @db.VarChar(320)
  emailPassword          String           @map("email_password")
  emailSiteUrl           String           @map("email_site_url") @db.VarChar(2048)
  secondaryEmail         String?          @map("secondary_email") @db.VarChar(320)
  secondaryEmailPassword String?          @map("secondary_email_password")
  secondaryEmailSiteUrl  String?          @map("secondary_email_site_url") @db.VarChar(2048)
  status                 AccountStatus    @default(available)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  product                SteamProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  game                   SteamGame?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  orderItems             SteamOrderItem[]

  @@index([productId, status, createdAt])
  @@index([gameId, status, createdAt])
  @@map("steam_accounts")
}

model SteamOrderItem {
  id                        String              @id @default(uuid()) @db.Uuid
  productOrderId            String              @unique @map("product_order_id") @db.VarChar(100)
  naverOrderId              String              @map("naver_order_id") @db.VarChar(100)
  source                    OrderSource         @default(naver) @map("source")
  store                     Store?              @default(streampocket)
  productId                 String?             @map("product_id") @db.Uuid
  gameId                    String?             @map("game_id") @db.Uuid
  accountId                 String?             @map("account_id") @db.Uuid
  productName               String              @map("product_name") @db.VarChar(255)
  receiverPhoneNumber       String?             @map("receiver_phone_number") @db.VarChar(30)
  receiverName              String?             @map("receiver_name") @db.VarChar(100)
  unitPrice                 Int                 @map("unit_price")
  paymentAmount             Int?                @map("payment_amount")
  settlementAmount          Int?                @map("settlement_amount")
  decisionDate              DateTime?           @map("decision_date") @db.Timestamptz(6)
  fulfillmentStatus         FulfillmentStatus   @default(pending) @map("fulfillment_status")
  errorMessage              String?             @map("error_message")
  paidAt                    DateTime?           @map("paid_at") @db.Timestamptz(6)
  returnedAt                DateTime?           @map("returned_at") @db.Timestamptz(6)
  reviewGameSentAt          DateTime?           @map("review_game_sent_at") @db.Timestamptz(6)
  orderStatusAlimtalkSentAt DateTime?           @map("order_status_alimtalk_sent_at") @db.Timestamptz(6)
  friendLink1               String?             @map("friend_link1") @db.VarChar(500)
  friendLink2               String?             @map("friend_link2") @db.VarChar(500)
  // 스팀 친구 코드 (계정번호 accountid) — 친구링크 자동 생성 시 함께 저장, 수동 입력도 허용
  friendCode                String?             @map("friend_code") @db.VarChar(20)
  giftCode                  String?             @map("gift_code") @db.VarChar(200)
  gameUrl                   String?             @map("game_url") @db.VarChar(500)
  memo                      String?             @map("memo")
  // zqbg 발송상태 자동 조회 사용 여부 — 기본 꺼짐, 켠 주문만 폴링 대상
  zqbgAutoCheckEnabled      Boolean             @default(false) @map("zqbg_auto_check_enabled")
  estimatedCompletedAt      DateTime?           @map("estimated_completed_at") @db.Timestamptz(6)
  autoExtendCount           Int                 @default(0) @map("auto_extend_count")
  // 네이버 발송처리(dispatch) 완료 시각 — null이면 미발송(진행중 전환/완료 처리 시점에 dispatch 수행)
  naverDispatchedAt         DateTime?           @map("naver_dispatched_at") @db.Timestamptz(6)
  // 파티 승인 자동 생성 주문 → 원본 파티 신청 연결 (기능 도입 전 주문은 null).
  // 재신청→재승인 시 같은 신청에 주문이 여러 개 생길 수 있어 unique 아님
  partyApplicationId        String?             @map("party_application_id") @db.Uuid
  completedAt               DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  product                   SteamProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  game                      SteamGame?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  account                   SteamAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  partyApplication          PartyApplication?   @relation(fields: [partyApplicationId], references: [id], onDelete: SetNull)
  deliveryLogs              DeliveryLog[]
  registrations             SteamRegistration[]
  expense                   Expense?

  @@index([fulfillmentStatus, createdAt])
  @@index([naverOrderId])
  @@index([source, fulfillmentStatus, createdAt])
  @@index([store, fulfillmentStatus, createdAt])
  @@index([partyApplicationId])
  @@map("steam_order_items")
}

model SteamRegistration {
  id          String  @id @default(uuid()) @db.Uuid
  orderItemId String? @map("order_item_id") @db.Uuid

  // 파싱 항목 — 전부 nullable (best-effort 저장)
  steamId            String?  @map("steam_id") @db.VarChar(255)
  steamPassword      String?  @map("steam_password") @db.VarChar(255) // 평문 저장 (사용자 결정)
  gameName           String?  @map("game_name") @db.VarChar(255)
  buyerName          String?  @map("buyer_name") @db.VarChar(100)
  steamGuardCodes    String?  @map("steam_guard_codes") // 양식 A: 1회용 코드 원문 보존
  steamGuardDisabled Boolean? @map("steam_guard_disabled") // 양식 B: 가드 해제 여부
  refundConsent      Boolean  @default(false) @map("refund_consent")

  // 원본 / 메타
  rawMessage    String   @map("raw_message") @db.Text
  formVariant   String?  @map("form_variant") @db.VarChar(10) // A/B/C/unknown
  botUserKey    String   @map("bot_user_key") @db.VarChar(255)
  missingFields String[] @map("missing_fields") // 누락 필수항목 키

  matchStatus SteamRegistrationMatchStatus @default(unmatched) @map("match_status")
  status      SteamRegistrationStatus      @default(received)
  adminMemo   String?                      @map("admin_memo") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem SteamOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([matchStatus, createdAt])
  @@index([botUserKey, createdAt])
  @@map("steam_registrations")
}

model DeliveryLog {
  id                 String            @id @default(uuid()) @db.Uuid
  orderItemId        String?           @map("order_item_id") @db.Uuid
  partyApplicationId String?           @map("party_application_id") @db.Uuid
  channel            DeliveryChannel   @map("channel")
  recipient          String            @map("recipient") @db.VarChar(100)
  templateCode       String?           @map("template_code") @db.VarChar(50)
  message            String?           @map("message")
  status             DeliveryLogStatus @default(queued)
  errorMessage       String?           @map("error_message")
  providerMessageId  String?           @map("provider_message_id") @db.VarChar(100)
  sentAt             DateTime?         @map("sent_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  orderItem          SteamOrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  partyApplication   PartyApplication? @relation(fields: [partyApplicationId], references: [id], onDelete: Cascade)

  @@index([orderItemId, createdAt])
  @@index([partyApplicationId, createdAt])
  @@map("delivery_logs")
}

model AlimtalkSettings {
  id              String   @id @default(uuid()) @db.Uuid
  store           Store    @default(streampocket)
  enabled         Boolean  @default(true)
  messageTemplate String   @map("message_template")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([store])
  @@map("alimtalk_settings")
}

model ReviewCode {
  id        String           @id @default(uuid()) @db.Uuid
  gameName  String?          @map("game_name") @db.VarChar(255)
  code      String           @db.VarChar(255)
  status    ReviewCodeStatus @default(unused)
  usedBy    String?          @map("used_by") @db.VarChar(255)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([gameName])
  @@map("review_codes")
}

model SystemSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  alimtalkUnitCost       Decimal  @default(6.5) @map("alimtalk_unit_cost") @db.Decimal(7, 1)
  defaultDurationMinutes Int      @default(60) @map("default_duration_minutes")
  // 리뷰 적립 포인트 — 실결제액(총액 − 사용 포인트) 기준 3구간 차등.
  // 구간 개수를 3으로 못 박아 표 편집기·겹침 검증 없이 숫자 5개만 관리한다.
  // tier1Max 이하 → tier1Point / tier2Max 이하 → tier2Point / 그 초과 → tier3Point
  // 저장 시 tier1Max < tier2Max를 강제한다 (뒤집히면 중간 구간이 영영 안 나간다).
  reviewPointTier1Max    Int      @default(7000) @map("review_point_tier1_max")
  reviewPointTier2Max    Int      @default(10000) @map("review_point_tier2_max")
  reviewPointTier1Point  Int      @default(100) @map("review_point_tier1_point")
  reviewPointTier2Point  Int      @default(200) @map("review_point_tier2_point")
  reviewPointTier3Point  Int      @default(300) @map("review_point_tier3_point")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model ManualRevenue {
  id        String   @id @default(uuid()) @db.Uuid
  store     Store?
  date      DateTime @db.Date
  amount    Int
  memo      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([date])
  @@index([store, date])
  @@map("manual_revenues")
}

// 대시보드 캘린더 일일 메모 — 날짜당 1개, 전사 기준(store 구분 없음)
model DailyMemo {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("daily_memos")
}

model Expense {
  id               String          @id @default(uuid()) @db.Uuid
  store            Store?
  date             DateTime        @db.Timestamptz(6)
  category         ExpenseCategory
  payer            ExpensePayer    @default(song_donggeon)
  amount           Int
  memo             String?         @db.VarChar(500)
  steamOrderItemId String?         @unique @map("steam_order_item_id") @db.Uuid
  steamOrderItem   SteamOrderItem? @relation(fields: [steamOrderItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([date])
  @@index([category, date])
  @@index([store, date])
  @@map("expenses")
}

// ───────────────────────── 유저 인증 (OTTALL) ─────────────────────────

enum AuthProvider {
  local
  kakao
  google
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique @db.VarChar(320)
  password      String?
  name          String       @db.VarChar(100)
  phone         String       @unique @db.VarChar(20)
  phoneVerified Boolean      @default(false) @map("phone_verified")
  provider      AuthProvider @default(local)
  providerId    String?      @map("provider_id") @db.VarChar(255)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── 회원 탈퇴 (소프트 삭제 → 30일 후 크론이 완전 삭제) ──
  // 탈퇴 시 email/phone/providerId는 익명화해 유니크 제약을 비우고(즉시 재가입 허용),
  // 원본 연락처는 original* 컬럼에 보관해 관리자만 조회한다. 30일 후 행 전체 삭제.
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  withdrawalReason String?   @map("withdrawal_reason") @db.VarChar(500)
  withdrawnByAdmin Boolean   @default(false) @map("withdrawn_by_admin")
  originalEmail    String?   @map("original_email") @db.VarChar(320)
  originalPhone    String?   @map("original_phone") @db.VarChar(20)

  // 보유 포인트 잔액. 변동 근거는 PointTransaction에 남는다 —
  // 잔액이 진실이고 이력은 감사용이다(매번 SUM하면 신청 경로마다 집계가 붙는다).
  // 차감은 조건부 updateMany(잔액 >= 사용액)로만 해서 음수가 되지 않게 한다.
  pointBalance Int @default(0) @map("point_balance")

  termsAgreements   TermsAgreement[]
  partyApplications PartyApplication[]
  ownReviews        OwnReview[]
  communityPosts    CommunityPost[]
  socialAccounts    UserSocialAccount[]
  pointTransactions PointTransaction[]

  @@unique([provider, providerId])
  @@index([deletedAt])
  @@map("users")
}

// 계정에 연결된 소셜 로그인 수단 — 한 User에 여러 provider 연결 가능 (전화번호 기반 계정 통합).
// 소셜 매칭의 단일 진실 원천. User.provider는 "최초 가입 방식" 표시용, User.providerId는 신규 기록 중단(레거시).
model UserSocialAccount {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  provider   AuthProvider
  providerId String       @map("provider_id") @db.VarChar(255)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("user_social_accounts")
}

model TermsAgreement {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  type     String   @db.VarChar(30)
  agreedAt DateTime @default(now()) @map("agreed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("terms_agreements")
}

// ───────────────────────── OTT 상품 (OTTALL) ─────────────────────────

enum OwnProductStatus {
  recruiting
  closed
  expired
}

enum OwnProductType {
  personal
  shared
}

enum PartyDurationMode {
  countdown
  fixed
}

enum PartyApplicationStatus {
  pending
  confirmed
  cancelled
  expired
}

model OwnCategory {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(100)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  OwnProduct[]

  @@map("own_categories")
}

// 파티 규칙 템플릿 — 파티 생성/수정 시 notes(파티 규칙/메모)에 선택 적용하는 재사용 문구
model OwnRuleTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("own_rule_templates")
}

model OwnProduct {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(255)
  categoryId      String            @map("category_id") @db.Uuid
  durationDays    Int               @map("duration_days")
  price           Int
  dailyDiscount   Int               @default(0) @map("daily_discount")
  totalSlots      Int               @map("total_slots")
  filledSlots     Int               @default(0) @map("filled_slots")
  imagePath       String?           @map("image_path") @db.VarChar(500)
  notes           String?           @db.Text
  /// deprecated: 파티 공유계정 기능 제거(2026-07). 기존 데이터 보존을 위해 컬럼 유지 — 삭제 금지
  accountId       String?           @map("account_id") @db.Text
  /// deprecated: 파티 공유계정 기능 제거(2026-07). 기존 데이터 보존을 위해 컬럼 유지 — 삭제 금지
  accountPassword String?           @map("account_password") @db.Text
  status          OwnProductStatus  @default(recruiting)
  partyType       OwnProductType    @default(shared) @map("party_type")
  durationMode    PartyDurationMode @default(countdown) @map("duration_mode")
  startedAt       DateTime?         @map("started_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  leaderName      String            @map("leader_name") @db.VarChar(100)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     OwnCategory        @relation(fields: [categoryId], references: [id])
  applications PartyApplication[]
  reviews      OwnReview[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@map("own_products")
}

model PartyApplication {
  id          String                 @id @default(uuid()) @db.Uuid
  productId   String                 @map("product_id") @db.Uuid
  // 탈퇴 회원 완전 삭제 시 신청 내역은 익명(userId null)으로 보존 — 리뷰(Cascade)·파티 정합성 유지
  userId      String?                @map("user_id") @db.Uuid
  price       Int
  fee         Int
  totalAmount Int                    @map("total_amount")
  // 신청 시점에 차감한 포인트 (price/fee/totalAmount와 같은 스냅샷).
  // 실결제액은 파생값이라 저장하지 않는다 — 항상 totalAmount - usedPoint로 만든다.
  usedPoint   Int                    @default(0) @map("used_point")
  status      PartyApplicationStatus @default(pending)
  startedAt   DateTime?              @map("started_at") @db.Timestamptz(6)
  expiresAt   DateTime?              @map("expires_at") @db.Timestamptz(6)
  // 확정 후 반품(파티원 제거)된 시각 — 같은 카테고리 12시간 재신청 차단의 기준.
  // 거절·만료·만석 자동거절은 세팅하지 않는다. 재신청(revive) 시 null로 초기화.
  returnedAt  DateTime?              @map("returned_at") @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       OwnProduct          @relation(fields: [productId], references: [id])
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  review        OwnReview?
  deliveryLogs  DeliveryLog[]
  orderItems    SteamOrderItem[]
  otpCredential PartyOtpCredential?
  otpIssueLogs  PartyOtpIssueLog[]

  @@unique([productId, userId])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("party_applications")
}

// 파티 OTP 시크릿 — PartyApplication과 분리된 1:1 테이블.
// 분리 이유: PartyApplication은 include-all로 유저 응답에 실리는 경로가 많아, 같은 모델에 두면 암호문 유출 위험.
// secretEnc는 AES-256-GCM 암호문(lib/crypto.ts) — 어떤 API 응답에도 포함 금지. 행 존재 = 시크릿 등록됨
model PartyOtpCredential {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  secretEnc     String   @map("secret_enc") @db.Text
  issueCount    Int      @default(0) @map("issue_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  application PartyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("party_otp_credentials")
}

// 파티 OTP 발급 로그 — 발급·재발급 모두 1건씩 기록(모든 발급이 횟수 차감). 관리자 초기화 후에도 이력 보존
model PartyOtpIssueLog {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  application PartyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, issuedAt])
  @@map("party_otp_issue_logs")
}

model OwnReview {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  // 탈퇴 회원 완전 삭제 시 리뷰는 익명(userId null)으로 보존 — 화면에는 "탈퇴한 회원" 표시
  userId        String?  @map("user_id") @db.Uuid
  content       String   @db.Text
  rating        Int
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  application PartyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  product     OwnProduct       @relation(fields: [productId], references: [id])
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([rating, createdAt])
  @@map("own_reviews")
}

// 포인트 변동 이력. 잔액(User.pointBalance)의 근거이자 중복 방지 장치다.
//  - review_reward: 리뷰당 1회만 지급해야 하는데, 리뷰는 신청당 1개(unique)라
//    관리자가 지우면 재작성이 가능하다. 같은 reviewId의 지급 이력이 있으면 다시 주지 않는다.
//  - party_refund: 같은 applicationId에 이미 반환이 있으면 두 번 돌려주지 않는다.
// 근거 행(리뷰·신청)이 지워져도 이력은 남아야 하므로 FK를 걸지 않고 id만 보관한다.
enum PointTransactionType {
  review_reward // 리뷰 작성 적립 (+)
  review_revoke // 관리자 리뷰 삭제로 회수 (−)
  party_use // 파티 신청에 사용 (−)
  party_refund // 신청 거절·취소로 반환 (+)
}

model PointTransaction {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  type          PointTransactionType
  /// 적립은 양수, 차감은 음수
  amount        Int
  /// 변동 직후 잔액 — 나중에 어긋났을 때 어디서 틀어졌는지 추적용
  balanceAfter  Int                  @map("balance_after")
  /// 근거 식별자 (중복 지급·중복 반환 판정에 쓴다). FK 아님 — 원본이 삭제돼도 이력은 남는다
  reviewId      String?              @map("review_id") @db.Uuid
  applicationId String?              @map("application_id") @db.Uuid
  memo          String?              @db.VarChar(200)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reviewId, type])
  @@index([applicationId, type])
  @@map("point_transactions")
}

model PhoneVerification {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @db.VarChar(20)
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@map("phone_verifications")
}

// ───────────────────────── 커뮤니티 ─────────────────────────

enum CommunityCategory {
  notice
  free
}

model CommunityPost {
  id            String            @id @default(uuid()) @db.Uuid
  category      CommunityCategory
  title         String            @db.VarChar(200)
  content       String            @db.Text
  imageUrl      String?           @map("image_url") @db.VarChar(500)
  isPinned      Boolean           @default(false) @map("is_pinned")
  authorUserId  String?           @map("author_user_id") @db.Uuid
  authorAdminId String?           @map("author_admin_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(6)

  authorUser  User?  @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAdmin Admin? @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([deletedAt, category, createdAt])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, isPinned, createdAt])
  @@map("community_posts")
}

// ───────────────────────── GCOIN (PUBG 지코인) ─────────────────────────

enum GcoinProductStatus {
  on_sale // 판매중
  hidden // 숨김
  sold_out // 품절
}

enum GcoinProductCategory {
  gcoin // 지코인
  item // 아이템
}

model GcoinProduct {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @db.VarChar(255)
  category      GcoinProductCategory @default(gcoin)
  gcoinAmount   Int?                 @map("gcoin_amount") // 지코인 상품만 필수, 아이템은 null
  salePrice     Int                  @map("sale_price")
  listPrice     Int?                 @map("list_price") // 원화 정가 (수동 입력, 달러 정가가 있으면 응답에서 환산값이 우선)
  listPriceUsd  Decimal?             @map("list_price_usd") @db.Decimal(10, 2) // 달러 정가 (gcoin 카테고리 전용, 조회 시 환율로 원화 환산)
  description   String?              @db.Text
  imageUrl      String?              @map("image_url") @db.VarChar(500)
  sortOrder     Int                  @default(0) @map("sort_order")
  purchaseCount Int                  @default(0) @map("purchase_count")
  status        GcoinProductStatus   @default(hidden)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders GcoinOrder[]

  @@index([status, sortOrder])
  @@map("gcoin_products")
}

// 구매자 휴대폰 인증 (비회원 로그인) — OTTALL phone_verifications와 분리 (로직 상이, 격리)
model GcoinPhoneVerification {
  id              String   @id @default(uuid()) @db.Uuid
  phone           String   @db.VarChar(20)
  code            String   @db.VarChar(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  verified        Boolean  @default(false)
  attempts        Int      @default(0)
  privacyAgreedAt DateTime @map("privacy_agreed_at") @db.Timestamptz(6) // 개인정보 수집·이용 동의 증적
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@map("gcoin_phone_verifications")
}

enum GcoinOrderStatus {
  pending // 확인 중 (신청 접수)
  approved // 승인 (결제 확인 후 통합 주문관리 편입)
  rejected // 거절
}

model GcoinOrder {
  id               String           @id @default(uuid()) @db.Uuid
  orderNo          String           @unique @map("order_no") @db.VarChar(40) // PUBG_YYYYMMDDHHmmss_랜덤3
  productId        String           @map("product_id") @db.Uuid
  productName      String           @map("product_name") @db.VarChar(255) // 주문 시점 스냅샷
  gcoinAmount      Int?             @map("gcoin_amount") // 스냅샷 (아이템은 null)
  salePrice        Int              @map("sale_price") // 주문 시점 가격 스냅샷
  quantity         Int              @default(1) // 현재 1 고정 (장바구니 확장 대비)
  buyerPhone       String           @map("buyer_phone") @db.VarChar(20)
  status           GcoinOrderStatus @default(pending)
  rejectReason     String?          @map("reject_reason") @db.VarChar(500)
  steamOrderItemId String?          @unique @map("steam_order_item_id") @db.Uuid // 승인 시 편입된 통합주문
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  rejectedAt       DateTime?        @map("rejected_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  product GcoinProduct @relation(fields: [productId], references: [id])

  @@index([status, createdAt])
  @@index([buyerPhone, createdAt])
  @@map("gcoin_orders")
}

// 환율 — 통화쌍별 1행, 크론(09/15/21시 KST)이 upsert로 갱신
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @map("base_currency") @db.VarChar(3) // 예: USD
  quoteCurrency String   @map("quote_currency") @db.VarChar(3) // 예: KRW
  rate          Decimal  @db.Decimal(12, 4)
  fetchedAt     DateTime @map("fetched_at") @db.Timestamptz(6) // 마지막 성공 fetch 시각
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([baseCurrency, quoteCurrency])
  @@map("exchange_rates")
}

// 사이트 일별 고유 방문 — 사이트 × 브라우저(visitorId) × KST 날짜당 1행 (gcoin/ottall 공용)
// visitorId는 클라이언트 localStorage의 익명 uuid, visitDate는 KST 벽시계 'YYYY-MM-DD' 문자열
model SiteVisit {
  id           String   @id @default(uuid()) @db.Uuid
  site         String   @db.VarChar(10) // 'gcoin' | 'ottall' — 라우트 프리픽스에서 고정 (바디 신뢰 안 함)
  visitorId    String   @map("visitor_id") @db.Uuid
  visitDate    String   @map("visit_date") @db.VarChar(10)
  source       String   @db.VarChar(30) // 유입 분류값 (utils/referrerSource.ts) — 규칙 진화 대비 enum 아님
  referrerHost String?  @map("referrer_host") @db.VarChar(255)
  referrer     String?  @db.VarChar(500) // 원본 보존 — '기타' 상세 표시·추후 재분류용
  landingPath  String?  @map("landing_path") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([site, visitorId, visitDate]) // 하루 1회 백스톱 (createMany skipDuplicates)
  @@index([site, visitDate, source]) // 일별 추이·소스별 집계 커버
  @@map("site_visits")
}

// ─────────────────────────────────────────────────────────────
// 드라마 계정 관리 — 메모장으로 관리하던 OTT 멤버십 계정·파티원을 옮긴 것.
// 화면이 메모 원문과 글자까지 같아야 해서, 계산용 값과 "표기 원문"을 따로 보존한다.
// (capacityLabel="프라이빗", suffix=")-갤s26", notes="(로그아웃완료)")
// OTTALL 파티(OwnProduct/PartyApplication)와는 의도적으로 연결하지 않는다 —
// 중고나라·오픈챗 유입이 섞여 전원을 신청 레코드에 매칭할 수 없다.
model DramaAccount {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(320)
  // 비밀번호·OTP 시크릿 모두 AES-256-GCM 암호문 (lib/crypto.ts, env OTP_SECRET_ENC_KEY).
  // 계정 171개의 아이디·비번·2FA가 한 테이블에 모이므로 평문 저장하지 않는다.
  passwordEnc   String    @map("password_enc") @db.Text
  otpSecretEnc  String    @map("otp_secret_enc") @db.Text
  // 아래 4개가 모두 null이면 "계정만 등록된 상태"(멤버십 미개설).
  // platform은 마스터 테이블 없이 자유 문자열 — 쓰던 약칭(비글/드박/드웨)을 그대로 보존하고
  // 필터 목록은 등록된 값에서 distinct로 만든다.
  platform      String?   @db.VarChar(50)
  capacity      Int? // 계산용 정원. 프라이빗 = 1
  capacityLabel String?   @map("capacity_label") @db.VarChar(20) // 표시용 원문 "3인" / "프라이빗"
  dueAt         DateTime? @map("due_at") @db.Date // 멤버십 마감일
  notes         String[]  @default([]) // 파티원 형식이 아닌 괄호 줄 — 버리지 않고 그대로 보존
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members DramaMember[]

  @@index([dueAt])
  @@map("drama_accounts")
}

// 파티원 — 기간 만료 시 자동 삭제하지 않는다(연장 문의·입금 확인 중일 수 있어 수동 정리).
// 만료 여부는 컬럼으로 두지 않고 조회 시 endDate로 계산한다(날짜만 지나도 저장값은 거짓이 되므로).
model DramaMember {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  site       String?  @db.VarChar(50) // 스트림포켓/중고나라/오픈챗. null = 카톡 닉네임만 적힌 경우
  name       String   @db.VarChar(100)
  // 사이트와 이름 사이 공백 유무. 메모에 "중고나라#7561308"처럼 붙여 쓴 줄이 있어,
  // 원문을 글자까지 그대로 되돌리려면 이 구분이 필요하다 (site가 null이면 의미 없음)
  siteSpaced Boolean  @default(true) @map("site_spaced")
  // 시작 시각과 만료 시각이 같아 시각은 문자열 하나로 충분하다.
  // DateTime 하나로 합치지 않는 이유: 타임존 변환에서 날짜가 하루 밀릴 위험을 아예 만들지 않기 위함.
  // 정렬은 endDate → startTime 순 (HH:mm은 사전순 = 시간순).
  endDate    DateTime @map("end_date") @db.Date
  startTime  String   @map("start_time") @db.VarChar(5) // "01:30"
  days       Int
  suffix     String?  @db.VarChar(50) // 괄호 뒤 꼬리 원문 "-갤s26", " 아이폰"
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account DramaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([endDate])
  @@map("drama_members")
}
